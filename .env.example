# Find with: xcrun devicectl list devices
IOS_UDID=
# Your Xcode Personal Team or organization team ID (10 characters).
APPLE_TEAM_ID=
# Your own unique reverse-domain name. Sign this separate runner, NOT Shopify POS.
WDA_BUNDLE_ID=
