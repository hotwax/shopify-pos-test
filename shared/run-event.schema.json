{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hotwax.co/ios-testing/run-event.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "runId", "sequence", "at", "type", "data"],
  "properties": {
    "protocolVersion": { "const": 1 },
    "runId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,100}$" },
    "sequence": { "type": "integer", "minimum": 1 },
    "at": { "type": "string", "format": "date-time" },
    "type": { "enum": ["run-state", "step-started", "step-finished", "assertion", "artifact", "business-effect"] },
    "stepId": { "type": "string", "maxLength": 100 },
    "data": { "type": "object", "maxProperties": 50 }
  }
}
