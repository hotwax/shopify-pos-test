{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "types": ["node", "@wdio/globals/types", "@wdio/mocha-framework"]
  },
  "include": ["config/**/*.ts", "core/**/*.ts", "scripts/**/*.ts", "server/**/*.ts", "shared/**/*.ts", "test/**/*.ts", "ui/**/*.ts", "ui/**/*.d.ts", "vite.config.ts", "wdio.conf.ts"]
}
